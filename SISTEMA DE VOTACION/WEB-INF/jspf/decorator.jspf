<%@page import="java.util.*"%>

<%!
    // =============================================
    // COMPONENTE BASE (Interfaz)
    // =============================================
    public interface ReporteDecorator {
        String generar();
        String getDescripcion();
    }
    
    // =============================================
    // COMPONENTE CONCRETO (Reporte básico)
    // =============================================
    public class ReporteBase implements ReporteDecorator {
        private String titulo;
        private String contenido;
        
        public ReporteBase(String titulo, String contenido) {
            this.titulo = titulo;
            this.contenido = contenido;
        }
        
        @Override
        public String generar() {
            return "=== " + titulo + " ===\n" + contenido;
        }
        
        @Override
        public String getDescripcion() {
            return "Reporte básico";
        }
    }
    
    // =============================================
    // DECORADOR ABSTRACT (Base para todos los decoradores)
    // =============================================
    public abstract class ReporteDecorador implements ReporteDecorator {
        protected ReporteDecorator reporteDecorado;
        
        public ReporteDecorador(ReporteDecorator reporte) {
            this.reporteDecorado = reporte;
        }
        
        @Override
        public String getDescripcion() {
            return reporteDecorado.getDescripcion();
        }
    }
    
    // =============================================
    // DECORADORES CONCRETOS
    // =============================================
    
    // 1. Decorador: Firma digital
    public class FirmaDigitalDecorador extends ReporteDecorador {
        private String firmante;
        
        public FirmaDigitalDecorador(ReporteDecorator reporte, String firmante) {
            super(reporte);
            this.firmante = firmante;
        }
        
        @Override
        public String generar() {
            return reporteDecorado.generar() + "\n\n✒️ FIRMADO DIGITALMENTE POR: " + firmante;
        }
        
        @Override
        public String getDescripcion() {
            return reporteDecorado.getDescripcion() + " + Firma digital";
        }
    }
    
    // 2. Decorador: Sello de tiempo
    public class SelloTiempoDecorador extends ReporteDecorador {
        public SelloTiempoDecorador(ReporteDecorator reporte) {
            super(reporte);
        }
        
        @Override
        public String generar() {
            Date fecha = new Date();
            return reporteDecorado.generar() + "\n\n🕐 GENERADO: " + fecha.toString();
        }
        
        @Override
        public String getDescripcion() {
            return reporteDecorado.getDescripcion() + " + Sello de tiempo";
        }
    }
    
    // 3. Decorador: Encriptación simple
    public class EncriptarDecorador extends ReporteDecorador {
        public EncriptarDecorador(ReporteDecorator reporte) {
            super(reporte);
        }
        
        @Override
        public String generar() {
            String original = reporteDecorado.generar();
            // Encriptación simple (desplazamiento de caracteres)
            StringBuilder encriptado = new StringBuilder();
            for(char c : original.toCharArray()) {
                encriptado.append((char)(c + 1));
            }
            return "[ENCRIPTADO]\n" + encriptado.toString();
        }
        
        @Override
        public String getDescripcion() {
            return reporteDecorado.getDescripcion() + " + Encriptación";
        }
    }
    
    
    
    // 4. Decorador: Marca de agua
    public class MarcaAguaDecorador extends ReporteDecorador {
        private String marca;
        
        public MarcaAguaDecorador(ReporteDecorator reporte, String marca) {
            super(reporte);
            this.marca = marca;
        }
        
        @Override
        public String generar() {
            return "~~ " + marca + " ~~\n\n" + reporteDecorado.generar() + "\n\n~~ " + marca + " ~~";
        }
        
        @Override
        public String getDescripcion() {
            return reporteDecorado.getDescripcion() + " + Marca de agua";
        }
    }
%>

<%
    // Inicializar datos de ejemplo
    if(application.getAttribute("resultadosEjemplo") == null) {
        StringBuilder sb = new StringBuilder();
        sb.append("Candidato A: 450 votos\n");
        sb.append("Candidato B: 300 votos\n");
        sb.append("Candidato C: 200 votos\n");
        sb.append("Voto Blanco: 50 votos\n");
        sb.append("Total votos: 1000\n");
        application.setAttribute("resultadosEjemplo", sb.toString());
    }
%>