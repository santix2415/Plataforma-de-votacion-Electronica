<%@page import="java.util.*"%>

<%!
    // =============================================
    // SUBSISTEMAS (Componentes complejos)
    // =============================================
    
    // Subsistema de usuarios (Singleton)
    public class UsuarioSubsystem {
        private Map<String, UsuarioSimple> usuarios = new HashMap<>();
        private Map<String, Boolean> haVotado = new HashMap<>();
        
        private static UsuarioSubsystem instancia = new UsuarioSubsystem();
        private UsuarioSubsystem() {
            usuarios.put("12345", new UsuarioSimple("12345", "Administrador", "admin123", "admin"));
            usuarios.put("67890", new UsuarioSimple("67890", "Votante Prueba", "votante123", "votante"));
        }
        public static UsuarioSubsystem getInstance() { return instancia; }
        
        public boolean registrar(String cedula, String nombre, String password) {
            if(usuarios.containsKey(cedula)) return false;
            usuarios.put(cedula, new UsuarioSimple(cedula, nombre, password, "votante"));
            return true;
        }
        
        public UsuarioSimple login(String cedula, String password) {
            UsuarioSimple u = usuarios.get(cedula);
            if(u != null && u.getPassword().equals(password)) return u;
            return null;
        }
        
        public boolean haVotado(String cedula) {
            return haVotado.containsKey(cedula) && haVotado.get(cedula);
        }
        
        public void marcarVoto(String cedula) {
            haVotado.put(cedula, true);
        }
    }
    
    public class UsuarioSimple {
        private String cedula, nombre, password, rol;
        public UsuarioSimple(String c, String n, String p, String r) {
            cedula = c; nombre = n; password = p; rol = r;
        }
        public String getCedula() { return cedula; }
        public String getNombre() { return nombre; }
        public String getPassword() { return password; }
        public String getRol() { return rol; }
    }
    
    // Subsistema de votación
    public class VotacionSubsystem {
        private Map<String, Integer> votos = new HashMap<>();
        
        public boolean votar(String cedula, String candidatoId) {
            if(UsuarioSubsystem.getInstance().haVotado(cedula)) return false;
            int actual = votos.getOrDefault(candidatoId, 0);
            votos.put(candidatoId, actual + 1);
            UsuarioSubsystem.getInstance().marcarVoto(cedula);
            return true;
        }
        
        public Map<String, Integer> getResultados() {
            return new HashMap<>(votos);
        }
        
        public void reset() { votos.clear(); }
    }
    
    // Subsistema de exportación (usando Factory Method)
    public interface ExportadorSimple { String exportar(Map<String, Integer> datos); }
    public class ExportadorHTMLSimple implements ExportadorSimple {
        public String exportar(Map<String, Integer> datos) {
            StringBuilder sb = new StringBuilder("<table border='1'>");
            sb.append("<tr><th>Candidato</th><th>Votos</th></tr>");
            for(Map.Entry<String, Integer> e : datos.entrySet())
                sb.append("<tr><td>").append(e.getKey()).append("</td><td>").append(e.getValue()).append("</td></tr>");
            sb.append("</table>");
            return sb.toString();
        }
    }
    public class ExportadorTextoSimple implements ExportadorSimple {
        public String exportar(Map<String, Integer> datos) {
            StringBuilder sb = new StringBuilder();
            for(Map.Entry<String, Integer> e : datos.entrySet())
                sb.append(e.getKey()).append(": ").append(e.getValue()).append(" votos\n");
            return sb.toString();
        }
    }
    public class ExportadorJSONSimple implements ExportadorSimple {
        public String exportar(Map<String, Integer> datos) {
            StringBuilder sb = new StringBuilder("{ \"resultados\": [");
            boolean first = true;
            for(Map.Entry<String, Integer> e : datos.entrySet()) {
                if(!first) sb.append(",");
                sb.append("{\"candidato\":\"").append(e.getKey()).append("\",\"votos\":").append(e.getValue()).append("}");
                first = false;
            }
            sb.append("]}");
            return sb.toString();
        }
    }
    
    // =============================================
    // FACADE (Interfaz simplificada)
    // =============================================
    public class VotacionFacade {
        private UsuarioSubsystem usuarioSub = UsuarioSubsystem.getInstance();
        private VotacionSubsystem votacionSub = new VotacionSubsystem();
        
        // Operaciones de usuario
        public boolean registrarVotante(String cedula, String nombre, String password) {
            return usuarioSub.registrar(cedula, nombre, password);
        }
        
        public UsuarioSimple autenticar(String cedula, String password) {
            return usuarioSub.login(cedula, password);
        }
        
        public boolean yaVoto(String cedula) {
            return usuarioSub.haVotado(cedula);
        }
        
        // Operaciones de votación
        public boolean emitirVoto(String cedula, String candidatoId) {
            return votacionSub.votar(cedula, candidatoId);
        }
        
        public Map<String, Integer> obtenerResultados() {
            return votacionSub.getResultados();
        }
        
        // Operaciones de exportación
        public String exportarResultados(String formato) {
            Map<String, Integer> datos = obtenerResultados();
            if(datos.isEmpty()) return "No hay votos registrados.";
            ExportadorSimple exportador;
            if("TEXTO".equalsIgnoreCase(formato)) exportador = new ExportadorTextoSimple();
            else if("JSON".equalsIgnoreCase(formato)) exportador = new ExportadorJSONSimple();
            else exportador = new ExportadorHTMLSimple();
            return exportador.exportar(datos);
        }
        
        // Reiniciar sistema (para pruebas)
        public void reiniciarSistema() {
            votacionSub.reset();
            // No reiniciamos usuarios porque son los registrados
        }
    }
%>

<%
    // Guardar una única instancia de la fachada en la aplicación
    if(application.getAttribute("votacionFacade") == null) {
        application.setAttribute("votacionFacade", new VotacionFacade());
    }
%>