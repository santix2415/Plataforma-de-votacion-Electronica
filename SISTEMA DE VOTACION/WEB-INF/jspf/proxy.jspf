<%@page import="java.util.*"%>

<%!
    // =============================================
    // SUJETO REAL (Objeto original)
    // =============================================
    public interface ReporteVotacion {
        String generarResultados();
        String generarAuditoria();
        String getInfo();
    }
    
    public class ReporteReal implements ReporteVotacion {
        private Map<String, Integer> resultados;
        private List<String> auditoria;
        
        public ReporteReal() {
            // Simular datos costosos de obtener
            resultados = new LinkedHashMap<>();
            resultados.put("Candidato A", 450);
            resultados.put("Candidato B", 300);
            resultados.put("Candidato C", 200);
            resultados.put("Voto Blanco", 50);
            
            auditoria = new ArrayList<>();
            auditoria.add("Inicio de sesión - Admin");
            auditoria.add("Voto registrado - 10:30");
            auditoria.add("Voto registrado - 10:35");
            auditoria.add("Generación de reporte - 11:00");
        }
        
        @Override
        public String generarResultados() {
            StringBuilder sb = new StringBuilder();
            sb.append("=== RESULTADOS ELECTORALES ===\n");
            for(Map.Entry<String, Integer> e : resultados.entrySet()) {
                sb.append(e.getKey()).append(": ").append(e.getValue()).append(" votos\n");
            }
            return sb.toString();
        }
        
        @Override
        public String generarAuditoria() {
            StringBuilder sb = new StringBuilder();
            sb.append("=== REGISTRO DE AUDITORÍA ===\n");
            for(String evento : auditoria) {
                sb.append("- ").append(evento).append("\n");
            }
            return sb.toString();
        }
        
        @Override
        public String getInfo() {
            return "ReporteReal - Contiene resultados y auditoría del sistema";
        }
    }
    
    // =============================================
    // PROXY (Controla el acceso)
    // =============================================
    public class ReporteProxy implements ReporteVotacion {
        private ReporteReal reporteReal;
        private String rolUsuario;
        private String usuario;
        
        // Cache para resultados (usado por admin)
        private String cacheResultados = null;
        private long cacheTime = 0;
        private static final long CACHE_DURATION = 30000; // 30 segundos
        
        public ReporteProxy(String usuario, String rol) {
            this.usuario = usuario;
            this.rolUsuario = rol;
        }
        
        private void registrarAccion(String accion) {
            System.out.println("[AUDITORÍA] " + new Date() + " - Usuario: " + usuario + 
                               " - Rol: " + rolUsuario + " - Acción: " + accion);
        }
        
        private boolean tienePermiso(String recurso) {
            if("admin".equalsIgnoreCase(rolUsuario)) {
                return true; // Admin tiene acceso a todo
            } else if("auditor".equalsIgnoreCase(rolUsuario)) {
                return "auditoria".equals(recurso); // Auditor solo ve auditoría
            } else {
                return false; // Votante no ve reportes
            }
        }
        
        @Override
        public String generarResultados() {
            registrarAccion("Intento de generar resultados");
            
            if(!tienePermiso("resultados")) {
                return "❌ ACCESO DENEGADO: Solo administradores pueden ver los resultados.";
            }
            
            // Cache para mejorar rendimiento
            long ahora = System.currentTimeMillis();
            if(cacheResultados != null && (ahora - cacheTime) < CACHE_DURATION) {
                registrarAccion("Resultados servidos desde CACHE");
                return "[CACHE] " + cacheResultados;
            }
            
            // Obtener del objeto real
            if(reporteReal == null) {
                reporteReal = new ReporteReal();
                registrarAccion("Creando reporte real");
            }
            registrarAccion("Generando resultados desde BD");
            cacheResultados = reporteReal.generarResultados();
            cacheTime = ahora;
            return cacheResultados;
        }
        
        @Override
        public String generarAuditoria() {
            registrarAccion("Intento de generar auditoría");
            
            if(!tienePermiso("auditoria")) {
                return "❌ ACCESO DENEGADO: No tiene permisos para ver la auditoría.";
            }
            
            if(reporteReal == null) {
                reporteReal = new ReporteReal();
            }
            registrarAccion("Auditoría generada exitosamente");
            return reporteReal.generarAuditoria();
        }
        
        @Override
        public String getInfo() {
            return "ReporteProxy - Controla acceso a " + usuario + " (rol: " + rolUsuario + ")";
        }
    }
    
    // =============================================
    // PROXY DE CACHÉ (versión alternativa)
    // =============================================
    public class ReporteCacheProxy implements ReporteVotacion {
        private ReporteReal reporteReal;
        private Map<String, String> cache = new HashMap<>();
        
        @Override
        public String generarResultados() {
            if(cache.containsKey("resultados")) {
                System.out.println("📦 Entregando resultados desde caché");
                return "[CACHÉ] " + cache.get("resultados");
            }
            
            if(reporteReal == null) reporteReal = new ReporteReal();
            String resultados = reporteReal.generarResultados();
            cache.put("resultados", resultados);
            System.out.println("💾 Resultados guardados en caché");
            return resultados;
        }
        
        @Override
        public String generarAuditoria() {
            if(reporteReal == null) reporteReal = new ReporteReal();
            return reporteReal.generarAuditoria();
        }
        
        @Override
        public String getInfo() {
            return "ReporteCacheProxy - Usa caché para mejorar rendimiento";
        }
    }
    
    // =============================================
    // PROXY VIRTUAL (Crea objeto real solo cuando es necesario)
    // =============================================
    public class ReporteVirtualProxy implements ReporteVotacion {
        private ReporteReal reporteReal;
        private String usuario;
        
        public ReporteVirtualProxy(String usuario) {
            this.usuario = usuario;
            System.out.println("🔄 Proxy virtual creado para: " + usuario);
        }
        
        private synchronized ReporteReal getReporteReal() {
            if(reporteReal == null) {
                System.out.println("⏳ Cargando reporte real por primera vez...");
                reporteReal = new ReporteReal();
                System.out.println("✅ Reporte real cargado");
            }
            return reporteReal;
        }
        
        @Override
        public String generarResultados() {
            return getReporteReal().generarResultados();
        }
        
        @Override
        public String generarAuditoria() {
            return getReporteReal().generarAuditoria();
        }
        
        @Override
        public String getInfo() {
            return "ReporteVirtualProxy (protegido) para " + usuario;
        }
    }
%>

<%
    // Inicializar proxy en sesión según el rol del usuario
    if(session.getAttribute("reporteProxy") == null) {
        String rol = (String) session.getAttribute("rol");
        if(rol == null) rol = "votante";
        String usuario = (String) session.getAttribute("nombre");
        if(usuario == null) usuario = "anonimo";
        
        // Crear el proxy adecuado
        ReporteVotacion proxy = new ReporteProxy(usuario, rol);
        session.setAttribute("reporteProxy", proxy);
    }
%>